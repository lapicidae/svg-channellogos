#!/bin/bash
#
# Convert SVG files (and PNGs) to PNG format using rsvg-convert
# with ImageMagick convert fallback.

set -euo pipefail

#######################################
# Global Configuration & Defaults
#######################################
readonly SCRIPT_NAME="${0##*/}"

WIDTH="800"
HEIGHT=""
OVERWRITE="false"
FIXED="false"
SQUARE="false"
UNLINK="false"
DEBUG="false"
INPUT_DIR=""
OUTPUT_DIR=""
HAS_RSVG="false"
HAS_CONVERT="false"
UNLINK_TMP=""

#######################################
# Cleans up temporary resources on script termination.
# Globals:
#   UNLINK_TMP
# Arguments:
#   None
# Outputs:
#   None
#######################################
cleanup() {
	if [[ -n "${UNLINK_TMP:-}" && -d "${UNLINK_TMP}" ]]; then
		rm -rf "${UNLINK_TMP}"
	fi
}

# Register signal trap for safe cleanup
trap cleanup EXIT INT TERM

#######################################
# Prints usage instructions to stderr.
# Globals:
#   SCRIPT_NAME
# Arguments:
#   None
# Outputs:
#   Writes usage text to stderr.
#######################################
usage() {
	printf "Usage: %s -i <input_dir> -o <output_dir> [-w <width>] [-r] [-s] [-u] [-f] [-d]\n" "${SCRIPT_NAME}" >&2
	printf "  -i: Input directory containing SVG/PNG files (required)\n" >&2
	printf "  -o: Output directory for rendered PNGs (required)\n" >&2
	printf "  -w: Target width in pixels (default: 800)\n" >&2
	printf "  -r: Fixed aspect ratio (16:9 rectangle)\n" >&2
	printf "  -s: Fixed aspect ratio (1:1 square)\n" >&2
	printf "  -u: Unlink symlinks in output directory\n" >&2
	printf "  -f: Overwrite existing PNG files\n" >&2
	printf "  -d: Enable debug logging\n" >&2
	exit 1
}

#######################################
# Converts a single SVG file to PNG format.
# Globals:
#   OUTPUT_DIR, WIDTH, HEIGHT, FIXED, OVERWRITE, DEBUG, HAS_RSVG, HAS_CONVERT
# Arguments:
#   file: Path to the input SVG file.
# Outputs:
#   Logs processing status to stdout/stderr.
#######################################
convert_file() {
	local file="$1"
	local base_name target
	base_name="$(basename "${file}" .svg)"
	target="${OUTPUT_DIR}/${base_name}.png"

	if [[ "${OVERWRITE}" != "true" && -f "${target}" ]]; then
		if [[ "${DEBUG}" == "true" ]]; then
			printf "Skipping existing file: %s\n" "${target}"
		fi
		return 0
	fi

	if [[ "${DEBUG}" == "true" ]]; then
		printf "Processing: %s -> %s\n" "${file}" "${target}"
	fi

	# 1. Primary conversion attempt via rsvg-convert
	if [[ "${HAS_RSVG}" == "true" ]]; then
		local rsvg_opts=(--keep-aspect-ratio --width="${WIDTH}")
		if [[ "${FIXED}" == "true" ]]; then
			rsvg_opts+=(--height="${HEIGHT}" --background-color=none)
		fi

		if rsvg-convert "${rsvg_opts[@]}" "${file}" --output="${target}" 2>/dev/null; then
			return 0
		fi
	fi

	# 2. Fallback conversion attempt via ImageMagick convert
	if [[ "${HAS_CONVERT}" == "true" ]]; then
		if [[ "${DEBUG}" == "true" ]]; then
			printf "Falling back to ImageMagick 'convert' for: %s\n" "${file}"
		fi
		local convert_opts=(-density "${WIDTH}" -background none -resize "${WIDTH}x${HEIGHT}")
		if [[ "${FIXED}" == "true" ]]; then
			convert_opts+=(-gravity center -extent "${WIDTH}x${HEIGHT}")
		fi

		if convert "${convert_opts[@]}" "${file}" "${target}" 2>/dev/null; then
			return 0
		fi
	fi

	printf "Error: Failed to convert '%s'.\n" "${file}" >&2
	return 1
}

#######################################
# Unlinks symlinks in the output directory by resolving them.
# Globals:
#   OUTPUT_DIR, DEBUG, UNLINK_TMP
# Arguments:
#   None
# Outputs:
#   Logs status to stdout.
#######################################
unlink_output_symlinks() {
	if [[ "${DEBUG}" == "true" ]]; then
		printf "Unlinking symlinks in output directory...\n"
	fi

	UNLINK_TMP="$(mktemp -d --suffix=_unlink)"

	local link
	while IFS= read -r -d '' link; do
		local target_file link_name
		target_file="$(readlink -f "${link}")"
		link_name="$(basename "${link}")"
		cp "${target_file}" "${UNLINK_TMP}/${link_name}" 2>/dev/null || true
	done < <(find "${OUTPUT_DIR}" -type l -print0)

	if find "${UNLINK_TMP}" -mindepth 1 -print -quit | grep -q .; then
		find "${UNLINK_TMP}" -mindepth 1 -maxdepth 1 -exec mv -t "${OUTPUT_DIR}/" {} + 2>/dev/null || true
	fi
}

#######################################
# Main script entry point.
# Arguments:
#   Command line flags.
#######################################
main() {
	while getopts "di:o:w:rsuf" opt; do
		case "${opt}" in
			d) DEBUG="true" ;;
			i) INPUT_DIR="${OPTARG}" ;;
			o) OUTPUT_DIR="${OPTARG}" ;;
			w) WIDTH="${OPTARG}" ;;
			r)
				FIXED="true"
				SQUARE="false"
				;;
			s)
				FIXED="true"
				SQUARE="true"
				;;
			u) UNLINK="true" ;;
			f) OVERWRITE="true" ;;
			*) usage ;;
		esac
	done

	if [[ -z "${INPUT_DIR}" || -z "${OUTPUT_DIR}" ]]; then
		printf "Error: Both input (-i) and output (-o) directories are required.\n" >&2
		usage
	fi

	if [[ ! -d "${INPUT_DIR}" ]]; then
		printf "Error: Input directory '%s' does not exist.\n" "${INPUT_DIR}" >&2
		exit 1
	fi

	INPUT_DIR="$(readlink -e "${INPUT_DIR}")"
	mkdir -p "${OUTPUT_DIR}"
	OUTPUT_DIR="$(readlink -e "${OUTPUT_DIR}")"

	# Calculate target height using native bash arithmetic
	if [[ "${FIXED}" == "true" ]]; then
		if [[ "${SQUARE}" == "true" ]]; then
			HEIGHT="${WIDTH}"
		else
			HEIGHT="$(( WIDTH * 9 / 16 ))"
		fi
		if [[ "${DEBUG}" == "true" ]]; then
			printf "Format set to fixed geometry: %sx%s px\n" "${WIDTH}" "${HEIGHT}"
		fi
	fi

	# Check availability of conversion binaries
	if command -v rsvg-convert >/dev/null 2>&1; then
		HAS_RSVG="true"
	fi
	if command -v convert >/dev/null 2>&1; then
		HAS_CONVERT="true"
	fi

	if [[ "${HAS_RSVG}" == "false" && "${HAS_CONVERT}" == "false" ]]; then
		printf "Error: Neither rsvg-convert nor ImageMagick convert is installed.\n" >&2
		exit 1
	fi

	# Process existing PNG files if present
	local png_count
	png_count="$(find "${INPUT_DIR}" -maxdepth 1 -type f -name "*.png" | wc -l)"
	if [[ "${png_count}" -gt 0 && "${HAS_CONVERT}" == "true" ]]; then
		if [[ "${DEBUG}" == "true" ]]; then
			printf "Processing PNG files via mogrify...\n"
		fi
		mogrify -path "${OUTPUT_DIR}" -auto-orient -thumbnail "${WIDTH}x" "${INPUT_DIR}"/*.png 2>/dev/null || true
	fi

	# 1. Convert SVG files sequentially
	local file
	for file in "${INPUT_DIR}"/*.svg; do
		if [[ -f "${file}" && ! -L "${file}" ]]; then
			convert_file "${file}"
		fi
	done

	# 2. Link resolution for symlinks
	for file in "${INPUT_DIR}"/*.svg; do
		if [[ -L "${file}" && -e "${file}" ]]; then
			local png_name target_link
			png_name="$(basename "${file}" .svg).png"
			target_link="$(basename "$(readlink "${file}")" .svg).png"
			ln -sf "${target_link}" "${OUTPUT_DIR}/${png_name}"
			if [[ "${DEBUG}" == "true" ]]; then
				printf "Created symlink: %s -> %s\n" "${png_name}" "${target_link}"
			fi
		fi
	done

	# 3. Unlink symlinks if requested
	if [[ "${UNLINK}" == "true" ]]; then
		unlink_output_symlinks
	fi

	if [[ "${DEBUG}" == "true" ]]; then
		printf "SVG to PNG conversion completed successfully.\n"
	fi
}

main "$@"
